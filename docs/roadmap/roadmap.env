RIG=starlinkee-www-conveyor
LEAD_ROLE=intake.lead
VERIFY_CMD="DATABASE_URL=postgresql://u:p@localhost:5432/db npm run build"

# Reset kontekstu agentów (opis: head -30 ~/bin/run-roadmap)
RESET=threshold          # threshold = reset po przekroczeniu progu | always = przed każdym krokiem | never
CTX_RESET_PCT=22         # próg: % kontekstu najbardziej zapchanego agenta
MAX_STEPS_NO_RESET=5     # bezpiecznik: reset najpóźniej po tylu krokach
